---
// Home page. Text marked data-placeholder is starter copy waiting to be replaced.
import Base from '../layouts/Base.astro';
import { site } from '../site.config';

const offerings = [
  {
    title: 'What you offer',
    text: 'A sentence or two about your main product or service, and who it helps.',
  },
  {
    title: 'How you work',
    text: 'What it is like to work with you, and what makes your approach different.',
  },
  {
    title: 'Why people choose you',
    text: 'The reason customers come back, in their words if you have them.',
  },
];
---

<Base>
  <section class="hero">
    <div class="container">
      <h1>{site.name}</h1>
      <p class="lead hero__tagline">{site.tagline}</p>
      <a class="button" href="/contact">Get in touch</a>
    </div>
  </section>

  <section class="section section--alt">
    <div class="container">
      <h2>What we do</h2>
      <ul class="cards">
        {
          offerings.map((item) => (
            <li class="card" data-placeholder>
              <h3>{item.title}</h3>
              <p>{item.text}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section">
    <div class="container reading">
      <h2>Ready to talk?</h2>
      <p data-placeholder>
        Tell visitors what to do next and what happens when they do. Most people want to know how
        quickly you will reply.
      </p>
      <a class="button" href="/contact">Contact us</a>
    </div>
  </section>
</Base>

<style>
  .hero {
    padding-block: var(--space-8);
    background: var(--color-bg-highlight);
  }

  .hero__tagline {
    max-width: var(--reading-width);
    margin-bottom: var(--space-6);
  }
</style>
