---
// Contact page. Email only: a contact form needs somewhere to send submissions,
// which a static site does not have. The contact form add-on sets one up.
import Base from '../layouts/Base.astro';
import { site } from '../site.config';
---

<Base title="Contact" description={`How to get in touch with ${site.name}.`}>
  <section class="section">
    <div class="container reading">
      <h1>Contact</h1>
      <p class="lead">The quickest way to reach us is email.</p>
      <p class="contact-email">
        <a href={`mailto:${site.email}`}>{site.email}</a>
      </p>
      <p data-placeholder>
        When you can expect a reply, and anything that helps people write to you: your hours,
        where you are based, or what to include in a first message.
      </p>
    </div>
  </section>
</Base>

<style>
  .contact-email {
    font-size: var(--text-xl);
    font-weight: var(--weight-medium);
  }
</style>
